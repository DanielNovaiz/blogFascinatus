# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_here
STRIPE_SECRET_KEY=sk_test_or_sk_live_here
STRIPE_WEBHOOK_SECRET=whsec_test_or_whsec_live_here

# OpenAI
OPENAI_API_KEY=sk-proj_or_sk_here

# Resend
RESEND_API_KEY=re_xxx_here
RESEND_FROM_EMAIL=orders@your-domain.com

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Admin Auth
ADMIN_JWT_SECRET=generate-a-strong-random-secret-here
